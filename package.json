{
  "name": "auto-manager-api",
  "version": "2.0.0-alpha.0",
  "description": "Autoforce Manager API — multi-tenant fleet, rental, work & pay and dealership platform",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "repository": "https://github.com/joelaj06/auto-manager-api.git",
  "author": "Joel Acquah <jacquah@appsolinfosystems.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps dist/worker.js",
    "db:setup": "tsx --env-file-if-exists=.env src/framework/cli/dbSetup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/framework/cli/dbMigrate.ts",
    "db:status": "tsx --env-file-if-exists=.env src/framework/cli/dbStatus.ts",
    "db:load-test": "tsx --env-file-if-exists=.env src/framework/cli/dbLoadTest.ts",
    "platform:invite-admin": "tsx --env-file-if-exists=.env src/framework/cli/platformInviteAdmin.ts",
    "backup": "tsx --env-file-if-exists=.env src/framework/cli/backup.ts",
    "storage:setup": "tsx --env-file-if-exists=.env src/framework/cli/storageSetup.ts",
    "mobile:keygen": "tsx src/framework/cli/mobileKeygen.ts",
    "load:health": "load/run.sh health",
    "load:auth": "load/run.sh auth-rejection",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "inversify": "^8.2.3",
    "jose": "^6.2.12",
    "nodemailer": "10.0.13",
    "pg": "^8.23.1",
    "pg-boss": "12.35.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8",
    "vitest": "^5.0.4"
  }
}
