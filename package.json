{
  "name": "auto-manager-api",
  "version": "2.0.0-alpha.0",
  "description": "Autoforce Manager API \u2014 multi-tenant fleet, rental, work & pay and dealership platform",
  "private": true,
  "type": "module",
  "main": "dist/bootstrap/main.js",
  "repository": "https://github.com/joelaj06/auto-manager-api.git",
  "author": "Joel Acquah <jacquah@appsolinfosystems.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/bootstrap/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/bootstrap/main.js",
    "db:setup": "tsx --env-file-if-exists=.env src/bootstrap/commands/db-setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/bootstrap/commands/db-migrate.ts",
    "db:status": "tsx --env-file-if-exists=.env src/bootstrap/commands/db-status.ts",
    "db:load-test": "tsx --env-file-if-exists=.env src/bootstrap/commands/db-load-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8",
    "vitest": "^5.0.4"
  }
}
