# Copy to .env for local development. Never commit .env.
# Only non-sensitive settings have defaults; secrets added later are required and have no fallback.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# json (one object per line, for servers) | pretty (readable, for local development)
LOG_FORMAT=pretty

# --- HTTP ---
# Reverse proxies in front of the app (0 locally; 1 behind Caddy/Traefik) — needed for client IPs.
TRUST_PROXY_HOPS=0
# Browser origins allowed by CORS: exact origins or wildcard subdomains, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
HTTP_BODY_LIMIT_KB=1024
# Serve /api/v1/openapi.json (defaults to true outside production).
EXPOSE_OPENAPI=true
SHUTDOWN_TIMEOUT_MS=15000

# --- PostgreSQL (one platform database + one database per tenant) ---
DATABASE_HOST=localhost
DATABASE_PORT=54320
# disable | require | verify-full  (must be set explicitly in production)
DATABASE_SSL=disable
PLATFORM_DATABASE_NAME=autoforce_platform
TENANT_TEMPLATE_DATABASE_NAME=tenant_template
TENANT_DATABASE_PREFIX=t_

# Application roles. Local-only passwords; production values come from a secret store.
PLATFORM_DB_USER=platform_app
PLATFORM_DB_PASSWORD=platform_app_local_only
TENANT_DB_USER=tenant_app
TENANT_DB_PASSWORD=tenant_app_local_only
MIGRATOR_DB_USER=migrator
MIGRATOR_DB_PASSWORD=migrator_local_only
# Read-only role for backups (pg_read_all_data); `yarn db:setup` creates it.
BACKUP_DB_USER=backup
BACKUP_DB_PASSWORD=backup_local_only

# --- Authentication (P0-7) ---
# Secrets of at least 32 characters; the platform secret must differ from the tenant secret.
# Local-only values; in production generate each with `openssl rand -base64 48` and keep them
# in the secret store. Rotating TENANT/PLATFORM_JWT_SECRET signs everyone out within
# ACCESS_TOKEN_TTL_SECONDS; rotating OTP_SECRET invalidates codes already sent.
TENANT_JWT_SECRET=tenant_jwt_secret_local_only_change_me_0123456789
PLATFORM_JWT_SECRET=platform_jwt_secret_local_only_change_me_0123456789
OTP_SECRET=otp_secret_local_only_change_me_0123456789abcdef
JWT_ISSUER=autoforce
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Platform console (P1-1) ---
# Encrypts staff authenticator (TOTP) secrets at rest; at least 32 characters.
MFA_ENCRYPTION_KEY=mfa_encryption_key_local_only_change_me_0123456789
PLATFORM_CONSOLE_URL=http://localhost:5173
PLATFORM_ACCESS_TOKEN_TTL_SECONDS=600
PLATFORM_SESSION_IDLE_MINUTES=60
PLATFORM_SESSION_MAX_HOURS=12
# Sign-in endpoints: requests per client IP per 15 minutes
AUTH_RATE_LIMIT_MAX=30

# --- Background jobs (P0-8): pg-boss in the platform database, run by `yarn dev:worker` ---
JOB_WORKER_CONCURRENCY=4
JOB_POOL_MAX=5

# --- Public signup (P1-2) ---
# Public web app origin, used in applicants' private status links
WEB_APP_URL=http://localhost:5174
# Platform SMS for signup phone codes. `log` writes the SMS to the API log (development only;
# refuses to send in production). A real provider is added once chosen.
SMS_PROVIDER=log

# --- Notifications (P2-9). Tenants' SMS go through each business's own provider account
# (Settings › Notifications), not through the platform. Push to the staff app: `log` writes
# pushes to the API log; `fcm` needs a Firebase service-account JSON file.
PUSH_PROVIDER=log

# Platform billing gateway (tenants paying Autoforce). `fake` = in-process gateway for local work
# (refused in production); `paystack` needs the secret key (use a test key locally). Point
# Paystack's webhook at <API>/api/v1/webhooks/billing.
BILLING_GATEWAY=fake
# PAYSTACK_SECRET_KEY=sk_test_...
# BILLING_RETURN_URL=http://localhost:5174/billing/return

# --- Console operations (on-call alerts, four-eyes thresholds) ---
# Comma-separated on-call emails; a Slack-compatible webhook ({"text": ...}).
# ONCALL_EMAILS=oncall@example.com
# ONCALL_WEBHOOK_URL=https://hooks.slack.com/services/...
# ONCALL_MIN_SEVERITY=warning
# Refunds above this (pesewas) need a second staff member's approval.
# REFUND_APPROVAL_THRESHOLD_MINOR=100000
# Announcement emails to more tenants than this need a Super Admin's approval.
# BULK_MESSAGE_APPROVAL_TENANTS=50
# FCM_SERVICE_ACCOUNT_FILE=firebase-service-account.json

# --- Backups (P0-4, docs/31). Files are encrypted for the public key; restores need the
# private key (kept off the server) and BACKUP_PRIVATE_KEY_PASSPHRASE.
BACKUP_DIR=backups
# BACKUP_PUBLIC_KEY_FILE=./backup-keys/autoforce-backup-public.pem
# local: pg_dump/pg_restore from the PATH; docker: from the postgres:18-alpine image
BACKUP_PG_TOOLS=docker
BACKUP_CONCURRENCY=2

# --- Object storage for files (S3-compatible). Locally: RustFS from compose.yaml; then run
# `yarn storage:setup` once to create the buckets. In production set the keys and
# FILES_PUBLIC_BASE_URL (CDN in front of the public bucket); leave STORAGE_ENDPOINT empty for AWS S3.
STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PRESIGN_ENDPOINT=   # when apps reach storage at another address than the API
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=autoforce
STORAGE_SECRET_ACCESS_KEY=autoforce_local_only
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRIVATE_BUCKET=autoforce-files
STORAGE_PUBLIC_BUCKET=autoforce-public
# FILES_PUBLIC_BASE_URL=http://localhost:9000/autoforce-public

# --- Mobile app connect (QR codes / deep links, docs/23). Locally the app connects to this
# server and links are signed with a fixed development key. In production set the URLs (https),
# the allowed hosts and a signing key from `yarn mobile:keygen` (or MOBILE_CONNECT_PRIVATE_KEY).
# MOBILE_API_BASE_URL=http://localhost:3000
# MOBILE_LINK_BASE_URL=http://localhost:5174
# MOBILE_ALLOWED_API_HOSTS=localhost:3000
# MOBILE_CONNECT_KEY_FILE=mobile-connect.key.pem
MOBILE_APP_SCHEME=autoforce
# App links (fill in once the apps are registered in the stores):
# MOBILE_ANDROID_PACKAGE=com.autoforce.manager
# MOBILE_ANDROID_CERT_SHA256=AB:CD:...
# MOBILE_IOS_APP_IDS=TEAMID1234.com.autoforce.manager
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.autoforce.manager
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000
# MOBILE_MIN_APP_VERSION=1.0.0
# MOBILE_LATEST_APP_VERSION=1.0.0

# --- Platform email (SMTP). Locally: Mailpit from compose.yaml, inbox at http://localhost:8025 ---
# SMTP_HOST and EMAIL_FROM must be set explicitly in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM=Autoforce Manager <no-reply@autoforce.localhost>

# Superuser connection used ONLY by `yarn db:setup` (never by the running app).
DATABASE_ADMIN_URL=postgres://autoforce:autoforce_local_only@localhost:54320/postgres

# --- Local services from compose.yaml (development only) ---
POSTGRES_USER=autoforce
POSTGRES_PASSWORD=autoforce_local_only
POSTGRES_PORT=54320
REDIS_PORT=63790
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
