# Copy to .env for local development. Never commit .env.
# Only non-sensitive settings have defaults; secrets added later are required and have no fallback.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Local services from compose.yaml (development only) ---
# Database settings are read by the app from Phase 0 work package P0-5 onward.
POSTGRES_USER=autoforce
POSTGRES_PASSWORD=autoforce_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
